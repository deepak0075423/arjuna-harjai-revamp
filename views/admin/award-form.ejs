<div class="admin-card">
    <h3><%= award ? 'Edit Award' : 'Add Award' %></h3>
    <form method="POST" action="<%= award ? '/admin/awards/' + award.id : '/admin/awards' %>">
        <div class="form-grid">
            <div class="form-group">
                <label for="year">Year</label>
                <input id="year" name="year" required value="<%= award ? award.year : '' %>">
            </div>
            <div class="form-group">
                <label for="tag">Tag</label>
                <input id="tag" name="tag" required value="<%= award ? award.tag : '' %>">
            </div>
            <div class="form-group full-width">
                <label for="title">Title</label>
                <input id="title" name="title" required value="<%= award ? award.title : '' %>">
            </div>
            <div class="form-group full-width">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5" required><%= award ? award.description : '' %></textarea>
                <div class="form-hint">You can use plain text. Keep it short for the slider.</div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-admin btn-gold"><%= award ? 'Update Award' : 'Create Award' %></button>
            <a href="/admin/awards" class="btn-admin btn-outline-admin">Cancel</a>
        </div>
    </form>
</div>

