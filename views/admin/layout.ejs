<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - ' : '' %>Admin Panel</title>
    <link rel="icon" type="image/png" href="/assets/images/gallery/favicon.png">
    <link rel="apple-touch-icon" href="/assets/images/gallery/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">ARJUNA HARJAI</div>
                <div class="sidebar-subtitle">Content Management</div>
            </div>
            <nav class="sidebar-nav">
                <div class="sidebar-section">Main</div>
                <a href="/admin" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                    Dashboard
                </a>

                <div class="sidebar-section">Content</div>
                <a href="/admin/hero" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'hero' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
                    Hero Section
                </a>
                <a href="/admin/about" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'about' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    About
                </a>
                <a href="/admin/awards" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'awards' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/></svg>
                    Awards
                </a>
                <a href="/admin/songs" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'songs' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    Songs
                </a>
                <a href="/admin/news" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'news' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v16a2 2 0 01-2 2zm0 0a2 2 0 01-2-2v-9c0-1.1.9-2 2-2h2"/></svg>
                    News
                </a>
                <a href="/admin/brands" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'brands' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M20 8v6m3-3h-6"/></svg>
                    Brands
                </a>
                <a href="/admin/youtube" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'youtube' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                    YouTube
                </a>
                <a href="/admin/reels" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'reels' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M10 9l5 3-5 3V9z"/></svg>
                    Reels
                </a>

                <div class="sidebar-section">Settings</div>
                <a href="/admin/contact-info" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'contact-info' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                    Contact Info
                </a>
                <a href="/admin/submissions" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'submissions' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    Submissions
                    <% if (typeof unreadSubmissions !== 'undefined' && unreadSubmissions > 0) { %>
                        <span class="sidebar-badge"><%= unreadSubmissions %></span>
                    <% } %>
                </a>
                <a href="/admin/footer" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'footer' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 15h18"/></svg>
                    Footer
                </a>
                <a href="/admin/settings" class="sidebar-link<%= typeof currentPage !== 'undefined' && currentPage === 'settings' ? ' active' : '' %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
                    Settings
                </a>
            </nav>

            <div class="sidebar-footer">
                <form method="POST" action="/logout" style="display:inline">
                    <button type="submit" class="btn-admin btn-outline-admin btn-sm" style="width:100%">Logout</button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <div class="admin-topbar">
                <h2><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h2>
                <div class="topbar-actions">
                    <a href="/" target="_blank" class="btn-admin btn-outline-admin btn-sm">View Site</a>
                </div>
            </div>

            <div class="admin-content">
                <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
                <div class="alert alert-<%= flash.type === 'error' ? 'error' : 'success' %>"><%= flash.message %></div>
                <% } %>

                <%- body %>
            </div>
        </main>
    </div>
</body>
</html>
