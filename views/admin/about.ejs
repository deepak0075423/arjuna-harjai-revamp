<div class="admin-card">
    <h3>About Section</h3>
    <form method="POST" action="/admin/about" enctype="multipart/form-data">
        <div class="form-grid">
            <div class="form-group full-width">
                <label for="about_intro">Intro</label>
                <textarea id="about_intro" name="about_intro" rows="3"><%= settings.about_intro || '' %></textarea>
            </div>
            <div class="form-group full-width">
                <label for="about_bio_1">Bio Paragraph 1</label>
                <textarea id="about_bio_1" name="about_bio_1" rows="4"><%= settings.about_bio_1 || '' %></textarea>
            </div>
            <div class="form-group full-width">
                <label for="about_bio_2">Bio Paragraph 2</label>
                <textarea id="about_bio_2" name="about_bio_2" rows="4"><%= settings.about_bio_2 || '' %></textarea>
            </div>
            <div class="form-group full-width">
                <label for="about_bio_3">Bio Paragraph 3</label>
                <textarea id="about_bio_3" name="about_bio_3" rows="4"><%= settings.about_bio_3 || '' %></textarea>
            </div>

            <div class="form-group full-width">
                <label for="about_image">About Image</label>
                <input id="about_image" type="file" name="about_image" accept="image/*">
                <% if (settings.about_image) { %>
                    <div class="image-preview"><img src="<%= settings.about_image %>" alt="Current about image"></div>
                <% } %>
                <div class="form-hint">Upload a new image to replace the current one.</div>
            </div>

            <div class="form-group">
                <label for="stat_1_number">Stat 1 Number</label>
                <input id="stat_1_number" name="stat_1_number" value="<%= settings.stat_1_number || '' %>">
            </div>
            <div class="form-group">
                <label for="stat_1_label">Stat 1 Label</label>
                <input id="stat_1_label" name="stat_1_label" value="<%= settings.stat_1_label || '' %>">
            </div>
            <div class="form-group">
                <label for="stat_2_number">Stat 2 Number</label>
                <input id="stat_2_number" name="stat_2_number" value="<%= settings.stat_2_number || '' %>">
            </div>
            <div class="form-group">
                <label for="stat_2_label">Stat 2 Label</label>
                <input id="stat_2_label" name="stat_2_label" value="<%= settings.stat_2_label || '' %>">
            </div>
            <div class="form-group">
                <label for="stat_3_number">Stat 3 Number</label>
                <input id="stat_3_number" name="stat_3_number" value="<%= settings.stat_3_number || '' %>">
            </div>
            <div class="form-group">
                <label for="stat_3_label">Stat 3 Label</label>
                <input id="stat_3_label" name="stat_3_label" value="<%= settings.stat_3_label || '' %>">
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-admin btn-gold">Save Changes</button>
            <a href="/admin" class="btn-admin btn-outline-admin">Cancel</a>
        </div>
    </form>
</div>

