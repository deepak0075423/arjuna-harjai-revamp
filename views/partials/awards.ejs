<!-- Awards Section -->
<section id="awards" class="section awards">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title animate-on-scroll">Awards</h2>
            <div class="section-line"></div>
            <p class="section-subtitle animate-on-scroll">Recognitions & milestones</p>
        </div>

        <div class="content-carousel awards-carousel animate-on-scroll" data-carousel tabindex="0" aria-label="Awards slider">
            <button class="slider-arrow slider-prev" type="button" data-carousel-prev aria-label="Previous awards">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 18l-6-6 6-6"/>
                </svg>
            </button>
            <button class="slider-arrow slider-next" type="button" data-carousel-next aria-label="Next awards">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 18l6-6-6-6"/>
                </svg>
            </button>

            <div class="carousel-track">
                <% awards.forEach((award, index) => { %>
                <article class="award-card animate-on-scroll">
                    <div class="award-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <% if (index % 3 === 0) { %>
                            <path d="M19 4h-3V2H8v2H5a1 1 0 0 0-1 1v3a5 5 0 0 0 4 4.9V15a4 4 0 0 0 3 3.87V21H8v2h8v-2h-3v-2.13A4 4 0 0 0 16 15v-2.1A5 5 0 0 0 20 8V5a1 1 0 0 0-1-1ZM6 8V6h2v4.74A3 3 0 0 1 6 8Zm10 2.74V6h2v2a3 3 0 0 1-2 2.74Z"/>
                            <% } else if (index % 3 === 1) { %>
                            <path d="M12 2 9.5 7.5 4 9l4 4-.95 5.5L12 16.9l4.95 1.6L16 13l4-4-5.5-1.5L12 2Z"/>
                            <% } else { %>
                            <path d="M7 3h10v2h3v4a5 5 0 0 1-5 5h-1v2h2v2H8v-2h2v-2H9A5 5 0 0 1 4 9V5h3V3Zm-1 4v2a3 3 0 0 0 3 3h1V7H6Zm10 5h1a3 3 0 0 0 3-3V7h-4v5Z"/>
                            <% } %>
                        </svg>
                    </div>
                    <div class="award-meta">
                        <span class="award-year"><%= award.year %></span>
                        <span class="award-tag"><%= award.tag %></span>
                    </div>
                    <h3 class="award-title"><%= award.title %></h3>
                    <p class="award-desc"><%- award.description %></p>
                </article>
                <% }); %>
            </div>
        </div>
    </div>
</section>
