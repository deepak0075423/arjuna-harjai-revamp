<!-- YouTube Videos Section -->
<section id="youtube" class="section youtube-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title animate-on-scroll">YouTube Videos</h2>
            <div class="section-line"></div>
        </div>

        <div class="video-slider animate-on-scroll" id="videoSlider">
            <!-- Slider Navigation -->
            <button class="slider-arrow slider-prev" id="sliderPrev" aria-label="Previous video">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button class="slider-arrow slider-next" id="sliderNext" aria-label="Next video">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>

            <!-- Slides Container -->
            <div class="slider-track" id="sliderTrack">
                <% youtubeVideos.forEach((video, index) => { %>
                <div class="slider-slide" data-yt-src="<%= video.embed_url %>">
                    <div class="video-banner-title">
                        <h3><%= video.title %></h3>
                        <span><%= video.subtitle %></span>
                    </div>
                    <div class="video-banner-embed">
                        <iframe width="560" height="315" src="<%= video.embed_url %>" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                    </div>
                </div>
                <% }); %>
            </div>

            <!-- Slider Dots -->
            <div class="slider-dots" id="sliderDots">
                <% youtubeVideos.forEach((video, index) => { %>
                <button class="slider-dot<%= index === 0 ? ' active' : '' %>" data-slide="<%= index %>" aria-label="Slide <%= index + 1 %>"></button>
                <% }); %>
            </div>
        </div>

        <div class="section-cta animate-on-scroll">
            <a href="<%= (typeof settings !== 'undefined' && settings.social_youtube) || 'https://www.youtube.com/@arjunaharjai' %>" target="_blank" rel="noopener" class="btn btn-outline">
                View All on YouTube
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" style="margin-left: 8px"><path d="M5 12h14m-7-7l7 7-7 7"/></svg>
            </a>
        </div>
    </div>
</section>

<!-- Video Lightbox -->
<div class="video-lightbox" id="videoLightbox">
    <button class="lightbox-close" aria-label="Close video">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
    <div class="lightbox-content">
        <div class="video-wrapper">
            <iframe id="lightboxVideo" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
    </div>
</div>
